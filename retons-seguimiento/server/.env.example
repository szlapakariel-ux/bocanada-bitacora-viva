# ── Desarrollo local (SQLite) ──
DATABASE_URL="file:./dev.db"
JWT_SECRET="cambiame-en-produccion"
PORT=4000

# ── Producción en Railway (SQLite con volumen persistente) ──
# 1) Agregá un Volume montado en /data
# 2) Seteá estas variables en el servicio:
# DATABASE_URL="file:/data/prod.db"
# JWT_SECRET="un-secreto-largo-y-aleatorio"
# (PORT lo inyecta Railway automáticamente)
#
# El server crea las tablas (db:deploy en el build) y siembra datos demo
# automáticamente en el primer arranque si la base está vacía.
