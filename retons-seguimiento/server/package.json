{
  "name": "retons-seguimiento-server",
  "version": "1.0.0",
  "description": "RETONS Seguimiento — API y backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "prisma db push --skip-generate && node src/index.js",
    "dev": "node --watch src/index.js",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push --skip-generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
